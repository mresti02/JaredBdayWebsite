---
import '../styles/styles.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jared Turns 30 · Puerto Vallarta · March 2026</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Navigation -->
  <nav class="nav" id="nav">
    <a href="#hero" class="nav-logo">JARED · 30</a>
    <button class="nav-hamburger" id="navHamburger" aria-label="Menu">
      <span></span><span></span><span></span>
    </button>
    <ul class="nav-links" id="navLinks">
      <li><a href="#info" class="nav-link">Details</a></li>
      <li><a href="#schedule" class="nav-link">Schedule</a></li>
      <li><a href="#meals" class="nav-link">Eats</a></li>
      <li><a href="#rooms" class="nav-link">Your Room</a></li>
      <li><a href="#venues" class="nav-link">Venues</a></li>
    </ul>
  </nav>

  <!-- ══════════════════════════════════ HERO ══════════════════════════════════ -->
  <section class="hero" id="hero">
    <div class="hero-photos">
      <div class="hero-photo-main jared-photo jared-photo--1"></div>
      <div class="hero-photo-stack">
        <div class="hero-photo-sm jared-photo jared-photo--9"></div>
        <div class="hero-photo-sm jared-photo jared-photo--5"></div>
      </div>
    </div>
    <div class="hero-left">
      <p class="hero-eyebrow">Puerto Vallarta · March 5–10, 2026</p>
      <h1 class="hero-title">
        She's<br/>
        <em>turning</em><br/>
        <span class="hero-num">30.</span>
      </h1>
      <p class="hero-tagline">16 gays · 1 villa · 6 days · zero restraint.</p>
      <div class="hero-actions">
        <a href="#schedule" class="btn btn-gold">See the Itinerary</a>
        <a href="#rooms" class="btn btn-outline-light">Find Your Room</a>
      </div>
    </div>
    <div class="hero-countdown-bar" id="heroCountdown">
      <div class="hc-item">
        <span class="hc-num" id="cdDays">--</span>
        <span class="hc-label">days</span>
      </div>
      <div class="hc-divider">:</div>
      <div class="hc-item">
        <span class="hc-num" id="cdHours">--</span>
        <span class="hc-label">hours</span>
      </div>
      <div class="hc-divider">:</div>
      <div class="hc-item">
        <span class="hc-num" id="cdMins">--</span>
        <span class="hc-label">mins</span>
      </div>
      <div class="hc-caption">until Puerto Vallarta</div>
    </div>
  </section>

  <!-- ══════════════════════════════ TRIP INFO ══════════════════════════════════ -->
  <section class="info-section" id="info">
    <div class="container">
      <div class="info-grid">
        <div class="info-text">
          <p class="eyebrow">The Details</p>
          <h2 class="section-title">It's giving <em>international</em>.</h2>
          <p class="info-desc">Thirty deserves a passport stamp. We're descending on Puerto Vallarta — 16 strong — for six days of sun, siestas, and sanctioned debauchery. Prepare accordingly. Hydrate. Pack a wig.</p>
          <div class="info-cards">
            <div class="info-card">
              <div class="info-card-icon">📅</div>
              <div class="info-card-body">
                <div class="info-card-label">Dates</div>
                <div class="info-card-value">March 5–10, 2026</div>
              </div>
            </div>
            <div class="info-card">
              <div class="info-card-icon">🏡</div>
              <div class="info-card-body">
                <div class="info-card-label">Our Villa</div>
                <div class="info-card-value">Las Villas PV</div>
              </div>
            </div>
            <div class="info-card">
              <div class="info-card-icon">📍</div>
              <div class="info-card-body">
                <div class="info-card-label">Address</div>
                <div class="info-card-value">
                  <a href="https://maps.app.goo.gl/csg12ny6PfZZEig56" target="_blank" rel="noopener" class="map-link">
                    Amapas, Puerto Vallarta<br/>Jalisco, Mexico
                    <span class="map-arrow">↗</span>
                  </a>
                </div>
              </div>
            </div>
            <div class="info-card">
              <div class="info-card-icon">👯</div>
              <div class="info-card-body">
                <div class="info-card-label">Guest Count</div>
                <div class="info-card-value">16 absolutely fabulous people</div>
              </div>
            </div>
          </div>
        </div>
        <div class="info-gallery">
          <div class="info-gallery-main jared-photo jared-photo--2">
            <div class="info-gallery-label">The Birthday Boy</div>
          </div>
          <div class="info-gallery-pair">
            <div class="info-gallery-sm villa-img villa-img--1"></div>
            <div class="info-gallery-sm jared-photo jared-photo--9"></div>
            <div class="info-gallery-sm villa-img villa-img--2"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════ SCHEDULE ════════════════════════════════ -->
  <section class="schedule-section" id="schedule">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">The Itinerary</p>
        <h2 class="section-title">Six days of <em>everything</em>.</h2>
        <p class="section-desc">Planned days, legendary nights. Tap any event to download it to your calendar.</p>
      </div>
      <div class="day-tabs" id="dayTabs" role="tablist">
        <button class="day-tab active" data-day="0" role="tab" aria-selected="true">
          <span class="day-tab-date">Mar 5</span>
          <span class="day-tab-label">Arrival</span>
        </button>
        <button class="day-tab" data-day="1" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 6</span>
          <span class="day-tab-label">Birthday Dinner</span>
        </button>
        <button class="day-tab" data-day="2" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 7</span>
          <span class="day-tab-label">Mantamar</span>
        </button>
        <button class="day-tab" data-day="3" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 8</span>
          <span class="day-tab-label">Day Cruise</span>
        </button>
        <button class="day-tab" data-day="4" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 9</span>
          <span class="day-tab-label">Recovery</span>
        </button>
        <button class="day-tab" data-day="5" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 10</span>
          <span class="day-tab-label">Checkout</span>
        </button>
      </div>
      <div class="schedule-panel" id="schedulePanel">
        <!-- Populated by JS -->
      </div>
      <div class="schedule-footer">
        <button class="btn btn-gold" id="downloadAllBtn">⬇ Download Full Trip (.ics)</button>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ MEALS ══════════════════════════════════ -->
  <section class="meals-section" id="meals">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">The Menu</p>
        <h2 class="section-title">We eat <em>well</em> here.</h2>
        <p class="section-desc">Chef-prepared meals throughout the week. Specific menus dropping soon — stay tuned.</p>
      </div>
      <div class="day-tabs day-tabs--pink" id="mealTabs" role="tablist">
        <button class="day-tab active" data-mday="0" role="tab" aria-selected="true">
          <span class="day-tab-date">Mar 5</span>
          <span class="day-tab-label">Arrival</span>
        </button>
        <button class="day-tab" data-mday="1" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 6</span>
          <span class="day-tab-label">Fri</span>
        </button>
        <button class="day-tab" data-mday="2" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 7</span>
          <span class="day-tab-label">Sat</span>
        </button>
        <button class="day-tab" data-mday="3" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 8</span>
          <span class="day-tab-label">Cruise</span>
        </button>
        <button class="day-tab" data-mday="4" role="tab" aria-selected="false">
          <span class="day-tab-date">Mar 9</span>
          <span class="day-tab-label">Recovery</span>
        </button>
      </div>
      <div class="meals-panel" id="mealsPanel">
        <!-- Populated by JS -->
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════ ROOM FINDER ════════════════════════════ -->
  <section class="rooms-section" id="rooms">
    <div class="rooms-bg jared-photo jared-photo--4"></div>
    <div class="rooms-overlay"></div>
    <div class="container rooms-inner">
      <div class="section-header section-header--light">
        <p class="eyebrow eyebrow--light">Room Assignments</p>
        <h2 class="section-title section-title--light">Find your <em>suite</em>, sis.</h2>
        <p class="section-desc section-desc--light">Type your name to see your room and your roommate. The packing list is on you.</p>
      </div>
      <div class="room-finder">
        <div class="room-search-bar">
          <input type="text" id="roomInput" class="room-input" placeholder="Your name…" autocomplete="off" />
          <button class="btn btn-gold" id="roomSearchBtn">Find My Room</button>
        </div>
        <div class="room-result" id="roomResult"></div>
        <div class="room-list-toggle">
          <button class="room-list-btn" id="roomListToggle">Show all room assignments ↓</button>
        </div>
        <div class="room-list" id="roomList" hidden>
          <!-- Populated by JS -->
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════ VENUES ═════════════════════════════════ -->
  <section class="venues-section" id="venues">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">The Spots</p>
        <h2 class="section-title">Places we'll <em>slay</em>.</h2>
      </div>
      <div class="venues-grid">

        <!-- Las Villas PV -->
        <div class="venue-card venue-card--wide">
          <div class="venue-img villa-img villa-img--3"></div>
          <div class="venue-body">
            <span class="venue-tag">Home Base · All Week</span>
            <h3 class="venue-name">Las Villas PV</h3>
            <p class="venue-desc">Our stunning private villa in Conchas Chinas — ocean views, a pool, and all the square footage 16 people need to exist without drama. (Results may vary on the drama.)</p>
            <a href="https://maps.app.goo.gl/csg12ny6PfZZEig56" target="_blank" rel="noopener" class="venue-map-btn">
              📍 Open in Google Maps
            </a>
          </div>
        </div>

        <!-- Mantamar -->
        <div class="venue-card">
          <div class="venue-img mantamar-img"></div>
          <div class="venue-body">
            <span class="venue-tag">March 7 · 12–6PM</span>
            <h3 class="venue-name">Mantamar Beach Club</h3>
            <p class="venue-desc">PV's iconic LGBT+ beach club. Reserved cabanas, a pool that never misses, and a crowd that absolutely knows what's good. It's our Saturday.</p>
            <a href="https://maps.google.com/?q=Mantamar+Beach+Club+Bar+Sushi+Puerto+Vallarta+Jalisco+Mexico" target="_blank" rel="noopener" class="venue-map-btn">
              📍 Open in Google Maps
            </a>
          </div>
        </div>

        <!-- Alley Cat Sailing -->
        <div class="venue-card">
          <div class="venue-img alleycat-img"></div>
          <div class="venue-body">
            <span class="venue-tag">March 8 · Day Cruise</span>
            <h3 class="venue-name">Alley Cat Sailing</h3>
            <p class="venue-desc">A full day on the Pacific — catamaran, open bar, breakfast and lunch on board. We're leaving at 8:50AM so set two alarms, queens.</p>
            <a href="https://maps.google.com/?q=Alley+Cat+Sailing+Puerto+Vallarta+Mexico" target="_blank" rel="noopener" class="venue-map-btn">
              📍 Open in Google Maps
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PHOTO STRIP ═══════════════════════════════ -->
  <section class="photo-strip">
    <div class="photo-strip-header">
      <h2 class="photo-strip-title">30 years of <em>this one</em>. ✨</h2>
    </div>
    <div class="photo-strip-scroll">
      <div class="strip-photo jared-photo jared-photo--1"></div>
      <div class="strip-photo jared-photo jared-photo--2"></div>
      <div class="strip-photo jared-photo jared-photo--3"></div>
      <div class="strip-photo jared-photo jared-photo--4"></div>
      <div class="strip-photo jared-photo jared-photo--5"></div>
      <div class="strip-photo jared-photo jared-photo--6"></div>
      <div class="strip-photo jared-photo jared-photo--7"></div>
      <div class="strip-photo jared-photo jared-photo--8"></div>
      <!-- Duplicate for seamless scroll -->
      <div class="strip-photo jared-photo jared-photo--1"></div>
      <div class="strip-photo jared-photo jared-photo--2"></div>
      <div class="strip-photo jared-photo jared-photo--3"></div>
      <div class="strip-photo jared-photo jared-photo--4"></div>
    </div>
  </section>

  <!-- ════════════════════════════════ FOOTER ══════════════════════════════════ -->
  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-title">Happy 30th, Jared.</div>
      <p class="footer-dates">Puerto Vallarta · March 5–10, 2026</p>
      <p class="footer-love">Made with love (and a lot of nerve) for the birthday boy. 🩷</p>
    </div>
  </footer>

</body>
</html>

<script>
  import '../scripts/script.js';
</script>
